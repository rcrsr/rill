{
  "name": "rill-lang",
  "version": "0.20.0",
  "description": "Scripting designed for machine-generated code",
  "private": true,
  "packageManager": "pnpm@11.18.0+sha512.33d83c77da82f49fba836925c6f1b841181ec3132b670639bd012f7075f5c7cf634c5f870147c19aae7478fac01df09d8892e880454896edd23ee9b33757563c",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rcrsr/rill.git"
  },
  "bugs": {
    "url": "https://github.com/rcrsr/rill/issues"
  },
  "homepage": "https://github.com/rcrsr/rill#readme",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prepare": "lefthook install --force",
    "bootstrap": "bash dev/bootstrap.sh",
    "build": "pnpm -r run build",
    "build:dev": "pnpm -r --if-present run build:dev",
    "test": "pnpm -r run test",
    "test:watch": "vitest",
    "test:examples": "pnpm --filter @rcrsr/rill run test:examples",
    "test:rules": "node dev/lint-rules/rule-unit-test.cjs",
    "check": "pnpm run check:versions && pnpm run check:standards && pnpm run check:format && pnpm run test:rules && pnpm -r run check && pnpm run check:deps",
    "check:types": "pnpm -r run typecheck",
    "check:lint": "pnpm -r run lint",
    "check:format": "oxfmt --check",
    "check:deps": "knip",
    "check:standards": "bash dev/check-standards.sh",
    "check:versions": "bash scripts/check-versions.sh",
    "fix:lint": "oxlint --fix",
    "fix:format": "oxfmt",
    "fix:versions": "bash scripts/sync-versions.sh"
  },
  "keywords": [
    "rill",
    "scripting",
    "dsl",
    "pipe",
    "workflow",
    "parser",
    "interpreter"
  ],
  "author": "Andre Bremer",
  "license": "MIT",
  "engines": {
    "node": ">=22.16.0",
    "pnpm": ">=11"
  },
  "devDependencies": {
    "@rcrsr/rill": "workspace:*",
    "@types/node": "^26.1.2",
    "knip": "^6.29.0",
    "lefthook": "^2.1.10",
    "oxfmt": "^0.61.0",
    "oxlint": "^1.76.0",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
