{
  "name": "rill-lang",
  "version": "0.21.0",
  "description": "Scripting designed for machine-generated code",
  "private": true,
  "packageManager": "pnpm@12.9.1+sha512.06b055fff5cd20dc12781de173ced3310ce0951bf2ec620211a16045d5444d5c93a663210764ef29a653a610459ba0368f0e74f84d80c54723cf95aae7bc0d6d",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rcrsr/rill.git"
  },
  "bugs": {
    "url": "https://github.com/rcrsr/rill/issues"
  },
  "homepage": "https://github.com/rcrsr/rill#readme",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prepare": "lefthook install --force",
    "bootstrap": "bash scripts/bootstrap.sh",
    "build": "pnpm -r run build",
    "build:dev": "pnpm -r --if-present run build:dev",
    "test": "pnpm -r run test",
    "test:watch": "vitest",
    "test:examples": "pnpm --filter @rcrsr/rill run test:examples",
    "test:examples:fixtures": "vitest run scripts/test-examples.fixtures.test.ts",
    "test:rules": "rill-test-rules",
    "check": "pnpm run check:versions && pnpm run check:standards && pnpm run typecheck:scripts && pnpm run check:format && pnpm run test:rules && pnpm run test:examples:fixtures && pnpm -r run check && pnpm run check:deps",
    "check:types": "pnpm -r run typecheck",
    "typecheck:scripts": "tsc -p scripts/tsconfig.json",
    "check:lint": "pnpm -r run lint",
    "check:format": "oxfmt --check",
    "check:deps": "knip",
    "check:standards": "rill-check-standards",
    "check:versions": "bash scripts/check-versions.sh",
    "fix:lint": "oxlint --fix",
    "fix:format": "oxfmt",
    "fix:versions": "bash scripts/sync-versions.sh",
    "fix:baseline": "node packages/dev/gen-baseline.cjs > packages/dev/baseline.json"
  },
  "keywords": [
    "rill",
    "scripting",
    "dsl",
    "pipe",
    "workflow",
    "parser",
    "interpreter"
  ],
  "author": "Andre Bremer",
  "license": "MIT",
  "engines": {
    "node": ">=22.16.0",
    "pnpm": ">=12"
  },
  "devDependencies": {
    "@rcrsr/rill": "workspace:*",
    "@rcrsr/rill-dev": "workspace:*",
    "@types/node": "^26.6.4",
    "knip": "^6.39.0",
    "lefthook": "^2.1.16",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
