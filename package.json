{
  "name": "rill-lang",
  "version": "0.21.0",
  "description": "Scripting designed for machine-generated code",
  "private": true,
  "packageManager": "pnpm@12.3.4+sha512.961aa41fb077da3a04a441d9f8e15ebc0c96da8ef710b2eb67bf9ee7cb0610eabd48f1fd85f51cffe73846785fa0f87c56a3a872a1d893f8446741b5cce45457",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rcrsr/rill.git"
  },
  "bugs": {
    "url": "https://github.com/rcrsr/rill/issues"
  },
  "homepage": "https://github.com/rcrsr/rill#readme",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prepare": "lefthook install --force",
    "bootstrap": "bash scripts/bootstrap.sh",
    "build": "pnpm -r run build",
    "build:dev": "pnpm -r --if-present run build:dev",
    "test": "pnpm -r run test",
    "test:watch": "vitest",
    "test:examples": "pnpm --filter @rcrsr/rill run test:examples",
    "test:examples:fixtures": "vitest run scripts/test-examples.fixtures.test.ts",
    "test:rules": "rill-test-rules",
    "check": "pnpm run check:versions && pnpm run check:standards && pnpm run check:format && pnpm run test:rules && pnpm run test:examples:fixtures && pnpm -r run check && pnpm run check:deps",
    "check:types": "pnpm -r run typecheck",
    "check:lint": "pnpm -r run lint",
    "check:format": "oxfmt --check",
    "check:deps": "knip",
    "check:standards": "rill-check-standards",
    "check:versions": "bash scripts/check-versions.sh",
    "fix:lint": "oxlint --fix",
    "fix:format": "oxfmt",
    "fix:versions": "bash scripts/sync-versions.sh",
    "fix:baseline": "node packages/dev/gen-baseline.cjs > packages/dev/baseline.json"
  },
  "keywords": [
    "rill",
    "scripting",
    "dsl",
    "pipe",
    "workflow",
    "parser",
    "interpreter"
  ],
  "author": "Andre Bremer",
  "license": "MIT",
  "engines": {
    "node": ">=22.16.0",
    "pnpm": ">=12"
  },
  "devDependencies": {
    "@rcrsr/rill": "workspace:*",
    "@rcrsr/rill-dev": "workspace:*",
    "@types/node": "^26.5.0",
    "knip": "^6.35.0",
    "lefthook": "^2.1.12",
    "oxfmt": "^0.67.0",
    "oxlint": "^1.82.0",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  }
}
