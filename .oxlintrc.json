{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  // Naming this array replaces oxlint's CLI defaults rather than extending
  // them, so a plugin left out here is silently off even though the tool
  // enables it by default. `unicorn` is the one that bites: it is default-on
  // from the CLI and was inert in this repo until it was listed. Every plugin
  // this repo wants is therefore named explicitly, including the ones that
  // report nothing. See packages/dev/REPO-STANDARDS.md STD-LINT-5 and STD-LINT-8.
  //
  // Enabling `unicorn` cost 3 findings, all no-useless-fallback-in-spread in
  // halt.ts, all fixed. Its other 137 rules sit in categories this config does
  // not enable, so they stay off through `categories`, not through omission.
  "plugins": ["typescript", "oxc", "import", "vitest", "promise", "unicorn"],
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "no-unused-vars": ["error", { "argsIgnorePattern": "^_" }],
    "eqeqeq": "error",
    "no-shadow": "error",
    // Caps a source file at 1000 lines of code, blank lines and comments not
    // counted. Tests are exempt in an override below.
    "max-lines": [
      "error",
      { "max": 1000, "skipBlankLines": true, "skipComments": true }
    ],
    "typescript/no-explicit-any": "error",
    // Exported functions need explicit types (0 hits when enabled); internal
    // functions may infer. explicit-function-return-type would also demand
    // them on internal functions (7 hits), which the TypeScript policy allows.
    "typescript/explicit-module-boundary-types": "error",
    "typescript/explicit-function-return-type": "off",
    "typescript/no-namespace": "error",
    "typescript/no-this-alias": "error",
    "typescript/ban-ts-comment": "error",
    "typescript/prefer-as-const": "error",
    "typescript/no-non-null-asserted-optional-chain": "error",
    "typescript/no-empty-object-type": "error",
    "typescript/no-require-imports": "error",
    "typescript/no-unsafe-declaration-merging": "error",
    "typescript/no-misused-new": "error",
    "typescript/no-extra-non-null-assertion": "error",
    "typescript/no-unnecessary-type-constraint": "error",
    "typescript/prefer-namespace-keyword": "error",
    "typescript/triple-slash-reference": "error",
    "typescript/no-duplicate-enum-values": "error",
    "typescript/no-unsafe-function-type": "error",
    "typescript/no-wrapper-object-types": "error",
    "typescript/no-array-constructor": "error",

    "import/no-cycle": "error",
    "import/no-self-import": "error",
    "import/no-empty-named-blocks": "error",
    "import/no-named-as-default-member": "error",

    "vitest/expect-expect": [
      "error",
      { "assertFunctionNames": ["expect", "expect*"] }
    ],
    "vitest/valid-expect": ["error", { "maxArgs": 2 }],
    "vitest/no-standalone-expect": "error",
    "vitest/no-identical-title": "error",
    "vitest/no-focused-tests": "error",
    "vitest/no-disabled-tests": "error",
    "vitest/no-commented-out-tests": "error",

    "promise/catch-or-return": ["error", { "allowThen": true }],
    "promise/no-return-wrap": "error",
    "promise/no-new-statics": "error",

    // Tier 1 pedantic rules, enabled one by one rather than through
    // categories.pedantic, because that category holds rules this config has
    // not measured. Counts at enablement over src/ and tests/, as fixed
    // outside the locked language arbiter vs exempt inside it (see the
    // tests/language override below):
    // - require-await: fixed 146 / exempt 22
    // - unicorn/prefer-string-slice: fixed 9 / exempt 7
    // - unicorn/no-useless-undefined: fixed 59 / exempt 5
    // - unicorn/prefer-at: fixed 41 / exempt 4
    // - unicorn/explicit-length-check: fixed 14 / exempt 0
    // - no-promise-executor-return: fixed 18 / exempt 0
    // - no-throw-literal: fixed 7 / exempt 0
    // - radix: fixed 2 / exempt 0
    "require-await": "error",
    "radix": "error",
    "no-throw-literal": "error",
    "no-promise-executor-return": "error",
    "unicorn/prefer-at": "error",
    "unicorn/no-useless-undefined": "error",
    "unicorn/explicit-length-check": "error",
    "unicorn/prefer-string-slice": "error",

    // Type-aware rules. These run through oxlint-tsgolint and only fire when
    // oxlint is given --type-aware; without the flag they are inert and
    // report nothing, so the package `lint` scripts for core, service and
    // fiddle pass it. packages/dev is untyped CommonJS and stays without it.
    // The flag ignores --tsconfig and discovers the nearest tsconfig.json per
    // file, which is why each tests/ tree carries its own tsconfig.json.
    // Pre-commit does not run them (see lefthook.yml).
    //
    // Two options are decided rather than defaulted:
    // - typescript/return-await uses "error-handling-correctness-only". The
    //   default "in-try-catch" demands `return await` inside try blocks and
    //   conflicts with the `return await` that the require-await fixes added.
    //   The spelling is load-bearing: an invalid enum value panics tsgolint.
    // - typescript/switch-exhaustiveness-check sets
    //   considerDefaultExhaustiveForUnions, so a `default` counts as covering
    //   a union switch. allowDefaultCaseForExhaustiveSwitch stays at its
    //   default. The array form keeps the severity readable as "error".
    //
    // Outcome per rule at enablement, as "fixed A, disabled inline B, exempt
    // C". Exempt sites sit in the locked tests/language arbiter, which the lock
    // forbids editing, or in a tests override below.
    // - no-unnecessary-type-assertion: fixed 445, disabled inline 0, exempt 24
    // - strict-boolean-expressions: fixed 105, disabled inline 0, exempt 24
    // - consistent-return: fixed 41, disabled inline 0, exempt 0
    // - strict-void-return: fixed 68, disabled inline 0, exempt 0
    // - return-await: fixed 4, disabled inline 0, exempt 0
    // - unbound-method: fixed 24, disabled inline 0, exempt 0
    // - no-base-to-string: fixed 12, disabled inline 2, exempt 108 (87 in
    //   tests, 21 in the arbiter). The two inline disables are in
    //   error-registry.ts (template context values are arbitrary host data)
    //   and types/registrations.ts (the fallback only sees primitives or
    //   values with a registered protocol); each carries its reason.
    // - switch-exhaustiveness-check: fixed 2, disabled inline 0, exempt 0
    // - no-floating-promises: fixed 19, disabled inline 0, exempt 0
    // - no-unsafe-member-access: fixed 36, disabled inline 0, exempt 230
    // - no-unsafe-assignment: fixed 40, disabled inline 0, exempt 112
    // - no-unsafe-call: fixed 3, disabled inline 0, exempt 0
    // - no-unsafe-return: fixed 2, disabled inline 0, exempt 1
    // - no-unsafe-argument: fixed 2, disabled inline 0, exempt 0
    //
    // Five more typescript rules fire under --type-aware because they sit in
    // the `correctness` category set to error above. They are driven by the
    // category and deliberately not listed in `rules`, so the shared baseline
    // does not bind consumers to rules measured only here. Same outcome form:
    // - restrict-template-expressions: fixed 1, disabled inline 0, exempt 91
    //   (75 in tests, 16 in the arbiter)
    // - no-redundant-type-constituents: fixed 3, disabled inline 0, exempt 7
    // - no-duplicate-type-constituents: fixed 3, disabled inline 0, exempt 0
    // - no-misused-spread: fixed 7, disabled inline 0, exempt 0
    // - require-array-sort-compare: fixed 1, disabled inline 0, exempt 0
    "typescript/no-unnecessary-type-assertion": "error",
    "typescript/strict-boolean-expressions": "error",
    "typescript/consistent-return": "error",
    "typescript/strict-void-return": "error",
    "typescript/return-await": ["error", "error-handling-correctness-only"],
    "typescript/unbound-method": "error",
    "typescript/no-base-to-string": "error",
    "typescript/switch-exhaustiveness-check": [
      "error",
      { "considerDefaultExhaustiveForUnions": true }
    ],
    "typescript/no-floating-promises": "error",
    "typescript/no-unsafe-member-access": "error",
    "typescript/no-unsafe-assignment": "error",
    "typescript/no-unsafe-call": "error",
    "typescript/no-unsafe-return": "error",
    "typescript/no-unsafe-argument": "error",

    // These four ship in their plugin's `correctness` category, so loading the
    // plugin above turns them on against the `categories` setting. Each is
    // switched off deliberately rather than by omission. Counts are measured on
    // this tree; 446 of them fall inside the locked language arbiter and so are
    // not fixable by a lint change at all.
    //
    // - vitest/no-conditional-expect (844 hits): the suite asserts inside
    //   branches by design, e.g. after a guard narrows a union.
    // - vitest/require-to-throw-message (80 hits): stylistic. rill asserts on
    //   typed halts and error IDs rather than on message text.
    // - vitest/require-mock-type-parameters (22 hits): stylistic; wants explicit
    //   type parameters on every vi.fn().
    // - promise/valid-params (15 hits): every one is a false positive. The rule
    //   pattern-matches `.catch(a, b)` against Promise.catch, but these are
    //   rill's own ctx.catch(thunk, handler) lifecycle facade.
    "vitest/no-conditional-expect": "off",
    "vitest/require-to-throw-message": "off",
    "vitest/require-mock-type-parameters": "off",
    "promise/valid-params": "off"

    // Also deliberately NOT enabled. Re-check before adding:
    // - promise/param-names (16 hits): stylistic; requires Promise executor
    //   params be named resolve/reject.
    // - import/no-duplicates (21 hits): only 7 are real duplicates. The other
    //   11 are `import type` + `import` from one module, which is the split
    //   verbatimModuleSyntax encourages and this tree uses widely; the
    //   prefer-inline option reports 98. It is a style choice, not a defect.
    // - no-unmodified-loop-condition (2 hits): both false positives on
    //   invariant guards (a const and an options field) where a different
    //   conjunct advances parser state and terminates the loop.

    // Every oxlint category beyond `correctness` was evaluated, and so were
    // the type-aware rules not enabled above. None of the rules below is on,
    // and each is off as a decision, not by omission. Scope: full src/ +
    // tests/ scope, oxlint 1.86.0. Counts are hits over core, service and
    // fiddle with the rule enabled alone on the command line (type-aware
    // rules with --type-aware), before any override in this file. A category
    // total excludes rules this config already enables and the type-aware
    // rules, which are counted in their own subsection. Recorded here so the
    // next reader does not have to re-measure to find out whether omitting
    // them was a decision.
    //
    // perf, 130 hits, 122 of them one rule:
    // - no-await-in-loop (122): this is the semantics, not a defect. rill is a
    //   sequential interpreter and its `seq` operator is defined to await each
    //   element in order. Parallelising is what `fan` is for.
    // - unicorn/prefer-set-has (5): the rule assumes a large array. The
    //   production hits are 3-element constant lists where a Set is slower.
    // - oxc/no-map-spread (3): the fix it suggests, Object.assign or in-place
    //   assignment, is worse than the conditional-spread idiom it flags.
    //
    // suspicious, 357 hits, 75 inside the locked language arbiter:
    // - unicorn/consistent-function-scoping (106): stylistic.
    // - no-underscore-dangle (92): contradicts this config's own
    //   argsIgnorePattern of ^_, which is how unused params are marked here.
    // - import/no-unassigned-import (52): side-effect imports in test setup.
    // - no-new (45): every hit is in tests/runtime, constructing a value to
    //   assert on the constructor. That is the test, not a side effect.
    // - unicorn/no-array-sort (24): wants toSorted; a style choice.
    // - oxc/no-this-in-exported-function (21): stylistic.
    // - promise/always-return (11), unicorn/require-post-message-target-origin
    //   (3), no-unmodified-loop-condition (2, already covered above),
    //   unicorn/no-array-reverse (1).
    //
    // pedantic, 2518 hits across the rules not enabled above. Most of the
    // volume is two rules that fight how this tree is written:
    // - max-lines-per-function (975): the default is 50 lines, and every
    //   evaluator handler is a long switch by design.
    // - no-inline-comments (331): trailing comments are used throughout to
    //   annotate table rows and union members.
    // - require-unicode-regexp (528): wants the `u` flag on every regex, which
    //   changes matching for no gain on the ASCII-only patterns used here.
    // - vitest/no-conditional-in-test (356): same reason as
    //   vitest/no-conditional-expect above; tests narrow unions with guards.
    // - no-negated-condition (136, 68 eslint and 68 unicorn): the two rules
    //   report the same sites; `if (!x) a else b` is often the clearer order.
    // - max-depth (35): parser and evaluator nesting follows the grammar.
    // - unicorn/prefer-string-replace-all (26): replace with a global regex is
    //   equivalent and already common.
    // - import/max-dependencies (29): barrel and test files import widely.
    // - no-lonely-if (28, 24 unicorn and 4 eslint): `else { if }` is used to
    //   keep a distinct condition readable.
    // - unicorn/no-array-callback-reference (14): passing a named function to
    //   map or filter is deliberate.
    // - remaining 14 rules, 60 hits combined.
    //
    // style, 47930 hits, stylistic throughout:
    // - one-var (5711), no-magic-numbers (6294), sort-keys (4148),
    //   capitalized-comments (2694), import/no-named-export (1037),
    //   func-style (1173), curly (997), id-length (1973),
    //   unicorn/no-null (1324): each contradicts the house style, which uses
    //   one declaration per binding, named exports, short loop names, and
    //   brace-free single statements. unicorn/no-null also flags the null
    //   that host APIs and JSON legitimately return.
    // - remaining 87 rules, 22579 hits combined, mostly vitest assertion-style
    //   preferences (prefer-expect-assertions alone is 7838).
    //
    // restriction, 17898 hits. These ban language features this codebase
    // uses on purpose:
    // - vitest/require-test-timeout (7790): the suite sets a global timeout
    //   and removes real-timer sleeps, so a per-test value adds nothing.
    // - oxc/no-async-await (5743): the host API is async.
    // - no-undefined (1220): `| undefined` is required on optional properties.
    // - oxc/no-optional-chaining (1063): idiomatic TypeScript.
    // - import/no-relative-parent-imports (1044): the layout imports across
    //   sibling folders with `../`.
    // - no-use-before-define (385): function declarations are hoisted and
    //   helpers sit below their callers.
    // - no-plusplus (302): loop counters.
    // - remaining 20 rules, 351 hits combined.
    //
    // nursery, 257 hits:
    // - no-undef (257): all false positives under TypeScript, which resolves
    //   names itself. The other two nursery rules are type-aware and are
    //   counted below.
    //
    // type-aware, 3889 hits across the rules not enabled above:
    // - typescript/prefer-readonly-parameter-types (2646): demands deep
    //   readonly on every parameter; the AST and RillValue types are not
    //   declared that way.
    // - typescript/promise-function-async (744): stylistic.
    // - typescript/no-unnecessary-condition (140): reports guards that
    //   protect against values the types do not model, such as host input.
    // - typescript/method-signature-style (117): property-style signatures are
    //   used consistently.
    // - typescript/explicit-member-accessibility (75): `public` on members is
    //   noise in a tree that avoids classes.
    // - typescript/non-nullable-type-assertion-style (57): stylistic.
    // - remaining 11 rules, 110 hits combined.
    //
    // typescript/no-non-null-assertion (988 hits) and
    // typescript/no-unsafe-type-assertion (1853 hits) over src/ and tests/
    // before scoping are on for shipped source in the overrides below. They
    // stay out of top-level rules so the shared baseline does not carry them.
  },
  "ignorePatterns": [
    "**/dist/**",
    "**/node_modules/**",
    "**/*.d.ts",
    "**/generated/**"
  ],
  "jsPlugins": ["@rcrsr/rill-dev/lint-rules"],
  "overrides": [
    {
      "files": ["**/generated/introspection-data.ts"],
      "rules": {
        "no-useless-escape": "off"
      }
    },
    {
      // The evaluator is a tree-walking interpreter: core.ts dispatches to each
      // handler, and every handler imports evaluateExpression back to recurse
      // into sub-expressions. The cycle is the dispatch shape, not an accident.
      // Removing it means reintroducing the indirection that #115 deleted, which
      // cost 214 `as unknown as` casts and made the evaluator type `any`. These
      // imports are safe because every cross-handler call happens at evaluation
      // time, never at module-init time.
      "files": [
        "**/src/runtime/core/eval/**/*.ts",
        "**/src/runtime/core/execute.ts"
      ],
      "rules": {
        "import/no-cycle": "off"
      }
    },
    {
      // The type registry and its protocols are mutually recursive: registrations
      // must know all 16 protocols to build BUILT_IN_TYPES, and a protocol
      // formatting a compound value must dispatch on its elements' types. The
      // established fix here is the late-binding initializer in protocols/shared.ts.
      // Extending that to the remaining edges would trade a deterministic,
      // ESM-safe static cycle for an implicit bootstrap contract, since nothing
      // would force registrations.js to load and dict must stay last.
      "files": [
        "**/src/runtime/core/callable.ts",
        "**/src/runtime/core/values.ts",
        "**/src/runtime/core/types/operations.ts",
        "**/src/runtime/core/types/registrations.ts",
        "**/src/runtime/core/types/protocols/index.ts",
        "**/src/runtime/core/types/protocols/closure.ts",
        "**/src/runtime/core/types/protocols/type.ts"
      ],
      "rules": {
        "import/no-cycle": "off"
      }
    },
    {
      // packages/core/tests/language/ is the language arbiter, snapshotted in
      // language.lock and enforced by lefthook and CI. It may only change for
      // language spec reasons, so its 122 remaining `any` casts cannot be typed
      // as part of a lint change. Production src/ carries zero.
      //
      // The same lock exempts four of the Tier 1 pedantic rules, since it
      // forbids lint-driven edits: require-await (22 hits),
      // unicorn/prefer-string-slice (7), unicorn/no-useless-undefined (5) and
      // unicorn/prefer-at (4). The other four Tier 1 rules report 0 here and
      // stay on.
      //
      // It also exempts five type-aware rules, for the same reason: the lock
      // forbids edits that would clear them. Measured inside the arbiter:
      // typescript/no-unsafe-member-access (230),
      // typescript/no-unsafe-assignment (112),
      // typescript/no-unnecessary-type-assertion (24),
      // typescript/strict-boolean-expressions (24) and
      // typescript/no-unsafe-return (1), plus two category-driven rules:
      // typescript/restrict-template-expressions (16) and
      // typescript/no-redundant-type-constituents (7).
      // typescript/no-base-to-string (21) is off for all tests by the tests
      // override below.
      "files": ["**/tests/language/**/*.ts"],
      "rules": {
        "typescript/no-explicit-any": "off",
        "require-await": "off",
        "unicorn/prefer-string-slice": "off",
        "unicorn/no-useless-undefined": "off",
        "unicorn/prefer-at": "off",
        "typescript/no-unsafe-member-access": "off",
        "typescript/no-unsafe-assignment": "off",
        "typescript/no-unnecessary-type-assertion": "off",
        "typescript/strict-boolean-expressions": "off",
        "typescript/no-unsafe-return": "off",
        "typescript/restrict-template-expressions": "off",
        "typescript/no-redundant-type-constituents": "off"
      }
    },
    {
      "files": ["**/src/runtime/**/*.ts"],
      "rules": {
        "rill/no-duplicate-error-id": "error"
      }
    },
    {
      // Scoped to shipped source. `packages/core/tests/language/` is the locked
      // language arbiter and still carries ~3.7k of these identifiers; it may
      // only change for language spec reasons, so it is out of this rule's
      // reach by design. src/ is what anyone reading the published package sees.
      "files": ["packages/*/src/**/*.{ts,tsx}"],
      "rules": {
        "rill/no-spec-id-reference": "error"
      }
    },
    {
      "files": ["**/src/lexer/**/*.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["**/parser/**", "**/runtime/**"],
                "message": "Layer violation: lexer is the bottom layer and must not import parser or runtime.",
                "allowTypeImports": true
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["**/src/parser/**/*.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["**/runtime/**"],
                "message": "Layer violation: parser must not import runtime. Runtime consumes the AST; the parser never sees the runtime.",
                "allowTypeImports": true
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["**/src/runtime/**/*.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["**/lexer/**", "**/parser/**"],
                "message": "Layer violation: runtime must not import lexer or parser directly. Use the top-level bridge modules (signature-parser.ts, ext-parse-bridge.ts).",
                "allowTypeImports": true
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["**/src/runtime/core/**/*.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["**/lexer/**", "**/parser/**"],
                "message": "Layer violation: runtime must not import lexer or parser directly. Use the top-level bridge modules (signature-parser.ts, ext-parse-bridge.ts).",
                "allowTypeImports": true
              },
              {
                "group": ["**/ext/**"],
                "message": "Layer violation: runtime/core must not import runtime/ext. Ext sits above core; inject registries via the runtime context instead.",
                "allowTypeImports": true
              }
            ]
          }
        ]
      }
    },
    {
      // enum, export default, and export * are replaced by as-const objects
      // and named exports. types.ts re-exports its sub-modules by design.
      "files": ["packages/*/src/**/*.{ts,tsx}"],
      "rules": {
        "rill/no-banned-syntax": [
          "error",
          { "allowExportAll": ["packages/core/src/types.ts"] }
        ]
      }
    },
    {
      // STD-LINT-6: the bans were decided in
      // https://github.com/rcrsr/rill/issues/501. They live in an override,
      // not top-level rules, so the baseline does not bind consumers. tests/
      // trees fall outside the glob, so the locked language arbiter is
      // untouched. no-unsafe-type-assertion is type-aware and runs only in
      // package lint scripts; no-non-null-assertion also runs in the
      // pre-commit hook. At enablement: 182 non-null hits in 46 files and 376 cast
      // hits in 76 files over shipped src/. All are removed and no shipped file
      // is exempt. A justified exception is an oxlint-disable-next-line comment
      // at the site with a -- reason, never a path in an override.
      "files": ["packages/*/src/**/*.{ts,tsx}"],
      "rules": {
        "typescript/no-non-null-assertion": "error",
        "typescript/no-unsafe-type-assertion": "error"
      }
    },
    {
      // 258 hits in 31 test files under src/: fiddle has 205 in 18 files under
      // src/**/__tests__/ (no-non-null-assertion 123, no-unsafe-type-assertion
      // 82). service has 53 in 13 co-located *.test.ts files (36 and 17).
      // Kept apart from the tests block below, which additionally lifts
      // max-lines, no-base-to-string and restrict-template-expressions.
      "files": [
        "packages/*/src/**/__tests__/**",
        "packages/*/src/**/*.test.{ts,tsx}"
      ],
      "rules": {
        "typescript/no-non-null-assertion": "off",
        "typescript/no-unsafe-type-assertion": "off"
      }
    },
    {
      // A __proto__ key assigned with brackets reparents the object.
      // setDictField lives in core and is not exported, so the rule is
      // scoped to core.
      "files": ["packages/core/src/**/*.ts"],
      "rules": {
        "rill/no-dict-bracket-assign": "error",
        "rill/no-new-runtime-error": "error"
      }
    },
    {
      // A catch around rill evaluation must let BreakSignal and ReturnSignal
      // through. reshapeHostThrow rethrows ControlSignal itself.
      "files": ["packages/core/src/runtime/**/*.ts"],
      "rules": {
        "rill/rethrow-control-signal": [
          "error",
          { "delegates": ["reshapeHostThrow"] }
        ]
      }
    },
    {
      // error-classes.ts defines RuntimeError, so it constructs it.
      "files": ["packages/core/src/error-classes.ts"],
      "rules": {
        "rill/no-new-runtime-error": "off"
      }
    },
    {
      // Sites that hosts and registration callers catch by class as
      // RuntimeError, kept on the plain class by decision rather than moved to
      // the halt builders. Several run during evaluation (bind-time argument
      // and default-value validation in callable.ts, list element inference in
      // operations.ts, createVector in constructors.ts), so this is not a
      // registration-time-only list.
      "files": [
        "packages/core/src/runtime/core/callable.ts",
        "packages/core/src/runtime/core/context.ts",
        "packages/core/src/runtime/core/field-descriptor.ts",
        "packages/core/src/runtime/core/policy/config-resolver.ts",
        "packages/core/src/runtime/core/resolvers.ts",
        "packages/core/src/runtime/core/types/constructors.ts",
        "packages/core/src/runtime/core/types/operations.ts",
        "packages/core/src/runtime/core/types/protocols/shared.ts",
        "packages/core/src/runtime/core/types/registrations.ts",
        "packages/core/src/runtime/core/types/status.ts",
        "packages/core/src/runtime/ext/extensions.ts",
        "packages/core/src/runtime/ext/test-context.ts"
      ],
      "rules": {
        "rill/no-new-runtime-error": "off"
      }
    },
    {
      // Halts surface as RuntimeHaltSignal or a rematerialised RuntimeError;
      // the halt helpers accept both, rejects.toThrow does not.
      "files": ["packages/core/tests/runtime/**/*.ts"],
      "rules": {
        "rill/use-halt-helpers": "error"
      }
    },
    {
      // Test files group many cases per behavior and the language arbiter is
      // locked, so the length cap applies to shipped source only.
      "files": ["**/tests/**", "**/__tests__/**"],
      "rules": {
        "max-lines": "off",
        // 108 hits across tests (87 outside the arbiter, 21 inside) for
        // no-base-to-string, and 75 outside the arbiter for
        // restrict-template-expressions. Fixtures interpolate rill values whose
        // runtime type the declared rill param fixes, and the only mechanical
        // fix is a cast.
        "typescript/no-base-to-string": "off",
        "typescript/restrict-template-expressions": "off"
      }
    },
    {
      // The error registry is one table of every error definition. Splitting
      // it would scatter the registry across files for no gain in readability.
      "files": ["packages/core/src/error-registry.ts"],
      "rules": {
        "max-lines": "off"
      }
    },
    {
      "files": ["packages/dev/lint-rules/**/*.cjs", "packages/dev/*.cjs"],
      "rules": {
        "typescript/no-require-imports": "off"
      }
    }
  ]
}
