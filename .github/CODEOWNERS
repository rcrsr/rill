# Code owners for rill. Template source for the ecosystem; see
# dev/REPO-STANDARDS.md STD-SUP-7.
#
# Last matching pattern wins, so the high-blast-radius paths sit at the bottom.

# Everything, unless a later rule overrides.
*                           @AndreBremer

# Release and CI machinery. A change here can disable every other gate in the
# repository, publish from an unverified tree, or widen a token's scope.
/.github/                   @AndreBremer
/.github/workflows/         @AndreBremer
/scripts/                   @AndreBremer

# Shared dev assets: the conformance standard and the lint rules every
# ecosystem repo derives from. A change here propagates to all of them.
/dev/                       @AndreBremer

# Toolchain and lint policy. Changes here silently alter what CI accepts
# everywhere else.
/.oxlintrc.json             @AndreBremer
/.oxfmtrc.json              @AndreBremer
/lefthook.yml               @AndreBremer
/knip.json                  @AndreBremer
/package.json               @AndreBremer
/pnpm-workspace.yaml        @AndreBremer

# The language arbiter. tests/language/ is the specification of record; it may
# only change for a deliberate language-spec reason.
/packages/core/tests/language/  @AndreBremer
