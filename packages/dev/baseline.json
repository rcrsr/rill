{
  "linter": "oxlint",
  "formatter": "oxfmt",
  "lintPlugins": [
    "import",
    "oxc",
    "promise",
    "typescript",
    "unicorn",
    "vitest"
  ],
  "lintRules": {
    "no-unused-vars": "error",
    "eqeqeq": "error",
    "no-shadow": "error",
    "max-lines": "error",
    "typescript/no-explicit-any": "error",
    "typescript/explicit-module-boundary-types": "error",
    "typescript/explicit-function-return-type": "off",
    "typescript/no-namespace": "error",
    "typescript/no-this-alias": "error",
    "typescript/ban-ts-comment": "error",
    "typescript/prefer-as-const": "error",
    "typescript/no-non-null-asserted-optional-chain": "error",
    "typescript/no-empty-object-type": "error",
    "typescript/no-require-imports": "error",
    "typescript/no-unsafe-declaration-merging": "error",
    "typescript/no-misused-new": "error",
    "typescript/no-extra-non-null-assertion": "error",
    "typescript/no-unnecessary-type-constraint": "error",
    "typescript/prefer-namespace-keyword": "error",
    "typescript/triple-slash-reference": "error",
    "typescript/no-duplicate-enum-values": "error",
    "typescript/no-unsafe-function-type": "error",
    "typescript/no-wrapper-object-types": "error",
    "typescript/no-array-constructor": "error",
    "import/no-cycle": "error",
    "import/no-self-import": "error",
    "import/no-empty-named-blocks": "error",
    "import/no-named-as-default-member": "error",
    "vitest/expect-expect": "error",
    "vitest/valid-expect": "error",
    "vitest/no-standalone-expect": "error",
    "vitest/no-identical-title": "error",
    "vitest/no-focused-tests": "error",
    "vitest/no-disabled-tests": "error",
    "vitest/no-commented-out-tests": "error",
    "promise/catch-or-return": "error",
    "promise/no-return-wrap": "error",
    "promise/no-new-statics": "error",
    "require-await": "error",
    "radix": "error",
    "no-throw-literal": "error",
    "no-promise-executor-return": "error",
    "unicorn/prefer-at": "error",
    "unicorn/no-useless-undefined": "error",
    "unicorn/explicit-length-check": "error",
    "unicorn/prefer-string-slice": "error",
    "typescript/no-unnecessary-type-assertion": "error",
    "typescript/strict-boolean-expressions": "error",
    "typescript/consistent-return": "error",
    "typescript/strict-void-return": "error",
    "typescript/return-await": "error",
    "typescript/unbound-method": "error",
    "typescript/no-base-to-string": "error",
    "typescript/switch-exhaustiveness-check": "error",
    "typescript/no-floating-promises": "error",
    "typescript/no-unsafe-member-access": "error",
    "typescript/no-unsafe-assignment": "error",
    "typescript/no-unsafe-call": "error",
    "typescript/no-unsafe-return": "error",
    "typescript/no-unsafe-argument": "error",
    "vitest/no-conditional-expect": "off",
    "vitest/require-to-throw-message": "off",
    "vitest/require-mock-type-parameters": "off",
    "promise/valid-params": "off"
  },
  "packageManager": "pnpm@12.18.0+sha512.9d7882d5dc82147ecfc4e062aa34834e0ad0296710a1837a1115ae012127d36b7109e321ac1598a1dd0a65597681b1e99917e12ed0d749eae91187943363beb3",
  "typescriptMajor": "7",
  "sharedTooling": {
    "@types/node": "^26.6.6",
    "knip": "^6.44.1",
    "lefthook": "^2.2.1",
    "oxfmt": "^0.76.0",
    "oxlint": "^1.91.0",
    "oxlint-tsgolint": "^7.0.2006",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "publishedVersions": {
    "@rcrsr/rill": "0.23.0",
    "@rcrsr/rill-language-service": "0.23.0"
  }
}
